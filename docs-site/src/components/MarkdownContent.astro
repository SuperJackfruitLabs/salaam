---
import DefaultContent from '@astrojs/starlight/components/MarkdownContent.astro';
---

<DefaultContent>
  <slot />
</DefaultContent>
<script>
  async function renderDiagrams() {
    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>('.salaam-diagram .mermaid:not([data-processed])'),
    );
    if (!nodes.length) return;
    try {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        // The docs theme's light values for Salaam (vibekit's pink and the suite's greys). The
        // figure stays light in both themes, since Mermaid takes fixed colours.
        themeVariables: {
          primaryColor: '#ffeaee',
          primaryTextColor: '#26252b',
          primaryBorderColor: '#b04568',
          lineColor: '#5e5b66',
          secondaryColor: '#efece6',
          tertiaryColor: '#f7f6f3',
          fontFamily: "'IBM Plex Sans', system-ui, sans-serif",
        },
      });
      await mermaid.run({ nodes });
    } catch {
      // A failed renderer leaves readable source instead of an empty diagram.
      for (const node of nodes) node.closest('figure')?.setAttribute('data-render-error', 'true');
    }
  }
  void renderDiagrams();
</script>
<style is:global>
  .salaam-diagram {
    margin-block: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: #f7f6f3;
    color: #26252b;
    overflow-x: auto;
  }
  .salaam-diagram pre {
    margin: 0;
    padding: 0;
    background: transparent;
    color: inherit;
  }
  .salaam-diagram svg {
    display: block;
    margin: auto;
    max-width: 100%;
    height: auto;
  }
</style>
