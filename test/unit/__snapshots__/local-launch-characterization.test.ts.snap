      "tool_uid": "<n>",
    },
  },
  "hook": {
    "launched": [
      {
        "argv": [
          "/nonexistent/bwrap",
          "--unshare-user",
          "--unshare-pid",
          "--unshare-ipc",
          "--unshare-uts",
          "--unshare-net",
          "--die-with-parent",
