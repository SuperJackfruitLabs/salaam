exports[`a seatbelt broker without socket host launches each kind of command the same way 1`] = `
{
  "background": {
    "approval": "Runs as your local user, in a Seatbelt sandbox (workspace-write): it can write only inside this workspace, and network: through the broker allowlist (hosts set by the stk policy), nothing direct. It can also read 1 operator-allowed path outside the workspace.
Directory: <root>
Runs in the background until stopped (at most 2 h); the last 64 KiB of output is kept
Command:
echo bg; sleep 5",
    "args": {
      "action": "command",
      "background": true,
      "command": "echo bg; sleep 5",
      "sandbox": {
        "bwrap": null,
        "kind": "seatbelt",
        "level": "workspace-write",
        "network": "broker",
      },
      "timeout_ms": 7200000,
    },
    "launched": [
      {
        "argv": [
          "/nonexistent/sandbox-exec",
          "-p",
          "(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read* (literal "/") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library/Apple") (subpath "/Library/Developer/CommandLineTools") (subpath "/Applications/Xcode.app") (subpath "/opt/homebrew") (subpath "/usr/local") (subpath "/private/etc") (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone") (subpath "/dev") (subpath "<root>") (subpath "<tmp>/salaam-cmd-<x>") (subpath "/opt/shared"))
(allow file-write* (subpath "<root>") (subpath "<tmp>/salaam-cmd-<x>") (literal "/dev/null") (literal "/dev/zero") (literal "/dev/stdout") (literal "/dev/stderr") (literal "/dev/tty") (regex #"^/dev/fd/"))
(allow file-ioctl (literal "/dev/null") (literal "/dev/zero") (literal "/dev/stdout") (literal "/dev/stderr") (literal "/dev/tty") (regex #"^/dev/fd/"))
(allow network-outbound (remote tcp "localhost:<port>"))",
          "/usr/bin/env",
          "TMPDIR=<tmp>/salaam-cmd-<x>/",
          "GIT_CONFIG_GLOBAL=/dev/null",
          "/bin/sh",
          "-c",
          "IFS= read -r salaam_start_gate || exit 125
exec 0</dev/null
echo bg; sleep 5",
        ],
        "cwd": "<root>",
        "detached": true,
        "env": {
          "GIT_AUTHOR_EMAIL": "fixture@example.com",
          "GIT_AUTHOR_NAME": "Fixture",
          "GIT_COMMITTER_EMAIL": "fixture@example.com",
          "GIT_COMMITTER_NAME": "Fixture",
          "HOME": "<home>",
          "HTTPS_PROXY": "http://127.0.0.1:<port>",
          "HTTP_PROXY": "http://127.0.0.1:<port>",
          "LANG": "en_US.UTF-8",
          "NO_PROXY": "localhost,127.0.0.1",
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
          "TMPDIR": "/tmp",
          "http_proxy": "http://127.0.0.1:<port>",
          "https_proxy": "http://127.0.0.1:<port>",
          "no_proxy": "localhost,127.0.0.1",
        },
        "stdio": [
          "pipe",
          "pipe",
          "pipe",
        ],
      },
    ],
    "tasks": [
      {
        "bytes": 9,
        "command": "echo bg; sleep 5",
        "ended_at": "<time>",
        "exit_code": null,
        "id": "task_<x>",
        "network": {
          "broker": "available",
          "connections": [],
        },
        "output": "stand-in
",
        "pid": "<n>",
        "started_at": "<time>",
        "state": "stopped",
        "task": {
          "exit_code": null,
          "id": "task_<x>",
          "state": "stopped",
        },
        "truncated": false,
      },
    ],
    "view": {
      "background": true,
      "isolation": "local-user-seatbelt-workspace-write",
      "network": "through the broker allowlist",
      "note": "Read its output with salaam_tasks; it keeps running after this turn.",
      "sandbox": "seatbelt",
      "state": "running",
      "task_id": "task_<x>",
    },
  },
  "command": {
    "approval": "Runs as your local user, in a Seatbelt sandbox (workspace-write): it can write only inside this workspace, and network: through the broker allowlist (hosts set by the stk policy), nothing direct. It can also read 1 operator-allowed path outside the workspace.
Directory: <root>
Timeout: 5000 ms
Command:
echo hi",
    "args": {
      "action": "command",
      "command": "echo hi",
      "sandbox": {
        "bwrap": null,
        "kind": "seatbelt",
        "level": "workspace-write",
        "network": "broker",
      },
      "timeout_ms": 5000,
    },
    "launched": [
      {
