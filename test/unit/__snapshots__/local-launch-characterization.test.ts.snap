exports[`a bubblewrap host launches each kind of command the same way 1`] = `
{
  "background": {
    "approval": "Runs as your local user, in a bubblewrap sandbox (workspace-write): it can write only inside this workspace, and has no network.
Directory: <root>
Runs in the background until stopped (at most 2 h); the last 64 KiB of output is kept
Command:
echo bg; sleep 5",
    "args": {
      "action": "command",
      "background": true,
      "command": "echo bg; sleep 5",
      "sandbox": {
        "bwrap": "bubblewrap 0.11.1",
        "kind": "bwrap",
        "level": "workspace-write",
      },
      "timeout_ms": 7200000,
    },
    "launched": [
      {
        "argv": [
          "/nonexistent/bwrap",
          "--unshare-user",
          "--unshare-pid",
          "--unshare-ipc",
          "--unshare-uts",
          "--unshare-net",
          "--die-with-parent",
          "--new-session",
          "--tmpfs",
          "/",
          "--ro-bind",
          "/usr",
          "/usr",
          "--ro-bind",
          "/etc/ssl",
          "/etc/ssl",
          "--ro-bind-try",
          "/lib",
          "/lib",
          "--ro-bind-try",
          "/lib64",
          "/lib64",
          "--ro-bind-try",
          "/lib32",
          "/lib32",
          "--ro-bind-try",
          "/bin",
          "/bin",
          "--ro-bind-try",
          "/sbin",
          "/sbin",
          "--ro-bind-try",
          "/etc/alternatives",
          "/etc/alternatives",
          "--proc",
          "/proc",
          "--dev",
          "/dev",
          "--tmpfs",
          "/tmp",
          "--bind",
          "<root>",
          "<root>",
          "--remount-ro",
          "/",
          "--chdir",
          "<root>",
          "--",
          "/bin/sh",
          "-c",
          "IFS= read -r salaam_start_gate || exit 125
exec 0</dev/null
echo bg; sleep 5",
        ],
        "cwd": "<root>",
        "detached": true,
        "env": {
          "GIT_AUTHOR_EMAIL": "fixture@example.com",
          "GIT_AUTHOR_NAME": "Fixture",
          "GIT_COMMITTER_EMAIL": "fixture@example.com",
          "GIT_COMMITTER_NAME": "Fixture",
          "HOME": "<home>",
          "LANG": "en_US.UTF-8",
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
          "TMPDIR": "/tmp",
        },
        "stdio": [
          "pipe",
          "pipe",
          "pipe",
        ],
      },
    ],
    "tasks": [
      {
        "bytes": 9,
        "command": "echo bg; sleep 5",
        "ended_at": "<time>",
        "exit_code": null,
        "id": "task_<x>",
        "output": "stand-in
",
        "pid": "<n>",
        "started_at": "<time>",
        "state": "stopped",
        "task": {
          "exit_code": null,
          "id": "task_<x>",
          "state": "stopped",
        },
        "truncated": false,
      },
    ],
    "view": {
      "background": true,
      "isolation": "local-user-bwrap-workspace-write",
      "note": "Read its output with salaam_tasks; it keeps running after this turn.",
      "sandbox": "bwrap",
      "state": "running",
      "task_id": "task_<x>",
    },
  },
  "command": {
    "approval": "Runs as your local user, in a bubblewrap sandbox (workspace-write): it can write only inside this workspace, and has no network.
Directory: <root>
Timeout: 5000 ms
Command:
