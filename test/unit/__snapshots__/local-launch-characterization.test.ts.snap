    },
    "launched": [
      {
        "argv": [
          "/nonexistent/bwrap",
          "--unshare-user",
          "--unshare-pid",
          "--unshare-ipc",
          "--unshare-uts",
          "--unshare-net",
          "--die-with-parent",
          "--new-session",
          "--tmpfs",
          "/",
          "--ro-bind",
          "/usr",
          "/usr",
          "--ro-bind",
          "/etc/ssl",
          "/etc/ssl",
          "--ro-bind-try",
          "/lib",
