          "/lib64",
          "/lib64",
          "--ro-bind-try",
          "/lib32",
          "/lib32",
          "--ro-bind-try",
          "/bin",
          "/bin",
          "--ro-bind-try",
          "/sbin",
          "/sbin",
          "--ro-bind-try",
          "/etc/alternatives",
          "/etc/alternatives",
          "--proc",
          "/proc",
          "--dev",
          "/dev",
          "--tmpfs",
          "/tmp",
          "--bind",
          "<root>",
          "<root>",
          "--remount-ro",
          "/",
          "--chdir",
          "<root>",
          "--",
          "/bin/sh",
          "-c",
          "cat; echo "$SALAAM_PROJECT_DIR"",
        ],
        "cwd": "<root>",
        "detached": true,
        "env": {
          "CLAUDE_PROJECT_DIR": "<root>",
          "HOME": "<home>",
          "LANG": "en_US.UTF-8",
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
          "SALAAM_PROJECT_DIR": "<root>",
          "TMPDIR": "/tmp",
        },
        "stdio": [
          "pipe",
          "pipe",
          "pipe",
        ],
      },
    ],
    "result": {
      "code": 0,
      "stderr": "",
      "stdout": "stand-in
",
      "timedOut": false,
      "truncated": false,
    },
  },
  "listen": {
    "error": "Error: On Linux the command sandbox has its own network namespace, so a server it starts cannot be reached from the host. Ask for full access for this command, or run the server yourself.",
  },
  "outside": {
    "approval": "Runs as your local user, unsandboxed for this one command, at its own request: it can read and change any file your user can and reach the network.
Directory: <root>
Timeout: 30000 ms
Outside the sandbox: needs the keychain. This one command runs without the OS sandbox; the session stays sandboxed. This always asks, except in YOLO or your own rule
Command:
echo out",
    "args": {
      "action": "command",
      "command": "echo out",
      "outside_sandbox": "needs the keychain",
      "sandbox": {
        "bwrap": "bubblewrap 0.11.1",
        "kind": "bwrap",
        "level": "full-access",
      },
      "timeout_ms": 30000,
    },
    "launched": [
      {
        "argv": [
          "/bin/sh",
          "-c",
          "IFS= read -r salaam_start_gate || exit 125
exec 0</dev/null
echo out",
        ],
        "cwd": "<root>",
        "detached": true,
        "env": {
          "HOME": "<home>",
          "LANG": "en_US.UTF-8",
          "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
          "TMPDIR": "/tmp",
        },
        "stdio": [
          "pipe",
          "pipe",
          "pipe",
        ],
