// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a plain offline session launches Pi with the pinned argv and environment 1`] = `
[
  {
    "args": [
      "<root>/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js",
      "--mode",
      "rpc",
      "--session-id",
      "<session>",
      "--session-dir",
      "<state>/workers/<session>/sessions",
      "--name",
      "salaam/<session>/1/<boot>",
      "--no-approve",
      "--no-extensions",
      "--extension",
      "<root>/dist/src/runtime/house-extension.js",
      "--no-mcp",
      "--no-skills",
      "--no-prompt-templates",
      "--no-themes",
      "--no-context-files",
      "--no-builtin-tools",
      "--tools",
      "consume_child_result,inspect_child,salaam_history,salaam_probe,salaam_review,spawn_child",
      "--provider",
      "salaam-proof",
      "--model",
      "scripted",
    ],
    "command": "<node>",
    "config_text": "{"socket":"<state>/bridge.sock","token":"<hex64>","session":"<session>","epoch":1,"bundle":"<hex64>","policy":"<hex64>","frame":"SALAAM_TASK_STATE {\\"binding\\":\\"<hex32>\\",\\"facts\\":[],\\"instructions\\":\\"Runtime bookkeeping, not a user message or a new task. Answer the latest actual user request. Empty facts mean no saved notes, not an empty workspace or missing objective. Inspect workspace tools for filesystem questions; history is only for prior conversation. Use active facts; superseded facts are historical. Do not repeat completed steps.\\",\\"session_id\\":\\"<session>\\",\\"version\\":0}","effects":false,"child":false,"route":{"provider":"salaam-proof","model":"scripted","max_tokens":1024},"local":false,"localCoding":false}",
    "cwd": "<state>",
    "env": {
      "HOME": "<state>/workers/<session>",
      "LANG": "<LANG>",
      "PATH": "<PATH>",
      "PI_CODING_AGENT_DIR": "<state>/workers/<session>/agent",
      "SALAAM_WORKER_CONFIG": {
        "bundle": "<hex64>",
        "child": false,
        "effects": false,
        "epoch": 1,
        "frame": "SALAAM_TASK_STATE {"binding":"<hex32>","facts":[],"instructions":"Runtime bookkeeping, not a user message or a new task. Answer the latest actual user request. Empty facts mean no saved notes, not an empty workspace or missing objective. Inspect workspace tools for filesystem questions; history is only for prior conversation. Use active facts; superseded facts are historical. Do not repeat completed steps.","session_id":"<session>","version":0}",
        "local": false,
        "localCoding": false,
        "policy": "<hex64>",
        "route": {
          "max_tokens": 1024,
          "model": "scripted",
          "provider": "salaam-proof",
        },
        "session": "<session>",
        "socket": "<state>/bridge.sock",
        "token": "<hex64>",
      },
      "TMPDIR": "<TMPDIR>",
    },
    "env_keys": [
      "PATH",
      "HOME",
      "TMPDIR",
      "LANG",
      "PI_CODING_AGENT_DIR",
      "SALAAM_WORKER_CONFIG",
    ],
  },
]
`;

