// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the house extension registers the same things with Pi: child 1`] = `
{
  "calls": [
    {
      "registerTool": [
        {
          "annotations": {
            "openWorldHint": false,
            "readOnlyHint": true,
          },
          "description": "Verify the managed tool gate without external effects.",
          "execute": "[function]",
          "label": "Salaam readiness probe",
          "name": "salaam_probe",
          "parameters": {
            "properties": {
              "nested": {
                "type": "boolean",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Inspect, list, search or read the exact admitted immutable repository snapshot. Reviewers may also inspect its diff. Paths and line references refer to this snapshot; no host file access, edits or commands are available.",
          "execute": "[function]",
          "label": "Repository snapshot",
          "name": "salaam_repository",
          "parameters": {
            "properties": {
              "action": {
                "anyOf": [
                  {
                    "const": "inspect",
                    "type": "string",
                  },
                  {
                    "const": "list",
                    "type": "string",
                  },
                  {
                    "const": "search",
                    "type": "string",
                  },
                  {
                    "const": "read",
                    "type": "string",
                  },
                  {
                    "const": "diff",
                    "type": "string",
                  },
                ],
              },
              "offset": {
                "minimum": 0,
                "type": "integer",
              },
              "path": {
                "maxLength": 512,
                "type": "string",
              },
              "query": {
                "maxLength": 256,
                "type": "string",
              },
            },
            "required": [
              "action",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Send, receive or acknowledge durable messages within this task. Messages never start or continue workers; delivery and acknowledgement are distinct.",
          "execute": "[function]",
          "label": "Team inbox",
          "name": "salaam_team",
          "parameters": {
            "properties": {
              "action": {
                "anyOf": [
                  {
                    "const": "send",
                    "type": "string",
                  },
                  {
                    "const": "receive",
                    "type": "string",
                  },
                  {
                    "const": "ack",
                    "type": "string",
                  },
                ],
              },
              "message_id": {
                "type": "string",
              },
              "recipient": {
                "type": "string",
              },
              "request_id": {
                "maxLength": 128,
                "type": "string",
              },
              "text": {
                "maxLength": 4096,
                "type": "string",
              },
            },
            "required": [
              "action",
              "request_id",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Publish final structured analysis over the admitted snapshot. Locations and source evidence are checked. Analysis cannot complete or verify a task.",
          "execute": "[function]",
          "label": "Record review findings",
          "name": "salaam_findings",
          "parameters": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "end_line": {
                      "minimum": 1,
                      "type": "integer",
                    },
                    "line": {
                      "minimum": 1,
                      "type": "integer",
                    },
                    "message": {
                      "maxLength": 2048,
                      "type": "string",
                    },
                    "path": {
                      "maxLength": 512,
                      "type": "string",
                    },
                    "severity": {
                      "anyOf": [
                        {
                          "const": "critical",
                          "type": "string",
                        },
                        {
                          "const": "high",
                          "type": "string",
                        },
                        {
                          "const": "medium",
                          "type": "string",
                        },
                        {
                          "const": "low",
                          "type": "string",
                        },
                      ],
                    },
                  },
                  "required": [
                    "path",
                    "line",
                    "severity",
                    "message",
                  ],
                  "type": "object",
                },
                "maxItems": 32,
                "type": "array",
              },
            },
            "required": [
              "findings",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "on": [
        "tool_call",
        "[function]",
      ],
    },
    {
      "on": [
        "session_before_compact",
        "[function]",
      ],
    },
    {
      "on": [
        "context",
        "[function]",
      ],
    },
    {
      "registerProvider": [
        "salaam-proof",
        {
          "api": "salaam-scripted",
          "apiKey": "local-fixture",
          "baseUrl": "http://unused.invalid",
          "models": [
            {
              "contextWindow": 32768,
              "cost": {
                "cacheRead": 0,
                "cacheWrite": 0,
                "input": 0,
                "output": 0,
              },
              "id": "scripted",
              "input": [
                "text",
              ],
              "maxTokens": 1024,
              "name": "Salaam offline proof provider",
              "reasoning": false,
            },
          ],
          "streamSimple": "[function]",
        },
      ],
    },
    {
      "on": [
        "session_start",
        "[function]",
      ],
    },
    {
      "on": [
        "session_shutdown",
        "[function]",
      ],
    },
  ],
  "prompt": "Base prompt.",
}
`;

exports[`the house extension registers the same things with Pi: coding 1`] = `
{
  "calls": [
    {
      "registerTool": [
        {
          "annotations": {
            "openWorldHint": false,
            "readOnlyHint": true,
          },
          "description": "Verify the managed tool gate without external effects.",
          "execute": "[function]",
          "label": "Salaam readiness probe",
          "name": "salaam_probe",
          "parameters": {
            "properties": {
              "nested": {
                "type": "boolean",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Reserve a request budget and start an independent read-only child. Reuse the same step key for retries.",
          "execute": "[function]",
          "label": "Spawn read-only child",
          "name": "spawn_child",
          "parameters": {
            "properties": {
              "authority": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "budget": {
                "maximum": 8,
                "minimum": 1,
                "type": "integer",
              },
              "profile": {
                "maxLength": 128,
                "type": "string",
              },
              "prompt": {
                "maxLength": 32768,
                "type": "string",
              },
              "step_key": {
                "maxLength": 128,
                "type": "string",
              },
              "tasks": {
                "items": {
                  "properties": {
                    "prompt": {
                      "type": "string",
                    },
                    "step_key": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "step_key",
                    "prompt",
                  ],
                  "type": "object",
                },
                "maxItems": 2,
                "type": "array",
              },
              "wait": {
                "type": "boolean",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "List durable child tasks and stable result IDs, or inspect one child.",
          "execute": "[function]",
          "label": "Inspect child inbox",
          "name": "inspect_child",
          "parameters": {
            "properties": {
              "child_id": {
                "type": "string",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Read the same durable result repeatedly. Set acknowledge only after processing it; reading alone never acknowledges.",
          "execute": "[function]",
          "label": "Read or acknowledge child result",
          "name": "consume_child_result",
          "parameters": {
            "properties": {
              "acknowledge": {
                "type": "boolean",
              },
              "child_id": {
                "type": "string",
              },
              "result_id": {
                "type": "string",
              },
            },
            "required": [
              "child_id",
              "result_id",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "annotations": {
            "openWorldHint": false,
            "readOnlyHint": true,
          },
          "description": "Request an operation-bound human decision; execute only the service-authorized operation.",
          "execute": "[function]",
          "label": "Approved read-only review",
          "name": "salaam_review",
          "parameters": {
            "properties": {
              "target": {
                "maxLength": 256,
                "type": "string",
              },
              "targets": {
                "items": {
                  "maxLength": 256,
                  "type": "string",
                },
                "maxItems": 8,
                "type": "array",
              },
              "value": {
                "maxLength": 4096,
                "type": "string",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Inspect/list/search/read an owned workspace or patch one UTF-8 file. Read returns one-based line references and a file hash. Before patching, inspect/read current revision and hash. expected_hash=null creates a new file, content=null deletes one. The source checkout and Git metadata stay outside this workspace.",
          "execute": "[function]",
          "label": "Guarded workspace files",
          "name": "salaam_files",
          "parameters": {
            "properties": {
              "action": {
                "anyOf": [
                  {
                    "const": "inspect",
                    "type": "string",
                  },
                  {
                    "const": "list",
                    "type": "string",
                  },
                  {
                    "const": "search",
                    "type": "string",
                  },
                  {
                    "const": "read",
                    "type": "string",
                  },
                  {
                    "const": "patch",
                    "type": "string",
                  },
                ],
              },
              "content": {
                "anyOf": [
                  {
                    "maxLength": 262144,
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "expected_hash": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "expected_revision": {
                "minimum": 0,
                "type": "integer",
              },
              "offset": {
                "minimum": 0,
                "type": "integer",
              },
              "path": {
                "maxLength": 512,
                "type": "string",
              },
              "query": {
                "maxLength": 256,
                "type": "string",
              },
            },
            "required": [
              "action",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "registerTool": [
        {
          "description": "Start/status/logs/cancel a command in a bounded, network-disabled disposable copy of the owned workspace. Use a stable step_key for retries: the same key returns the original run, never resends work. Supply the inspected expected_revision. Command edits are disposable; use salaam_files patch for durable changes. Commands are limited to 30 seconds and 64 KiB output. Start waits for the recorded outcome; clients may detach and inspect its stable run_id.",
          "execute": "[function]",
          "label": "Durable isolated command",
          "name": "salaam_command",
          "parameters": {
            "properties": {
              "action": {
                "anyOf": [
                  {
                    "const": "start",
                    "type": "string",
                  },
                  {
                    "const": "status",
                    "type": "string",
                  },
                  {
                    "const": "logs",
                    "type": "string",
                  },
                  {
                    "const": "cancel",
                    "type": "string",
                  },
                ],
              },
              "command": {
                "maxLength": 8192,
                "type": "string",
              },
              "cwd": {
                "maxLength": 512,
                "type": "string",
              },
              "expected_revision": {
                "minimum": 0,
                "type": "integer",
              },
              "offset": {
                "minimum": 0,
                "type": "integer",
              },
              "run_id": {
                "type": "string",
              },
              "step_key": {
                "maxLength": 128,
                "type": "string",
              },
            },
            "required": [
              "action",
            ],
            "type": "object",
          },
        },
      ],
    },
    {
      "on": [
        "tool_call",
        "[function]",
      ],
    },
    {
      "registerTool": [
        {
          "annotations": {
            "openWorldHint": false,
            "readOnlyHint": true,
          },
          "description": "List append-order history or retrieve an older entry/evidence artifact. Results are bounded; follow next_offset.",
          "execute": "[function]",
          "label": "Retrieve Salaam evidence",
          "name": "salaam_history",
          "parameters": {
            "properties": {
              "artifact_id": {
                "type": "string",
              },
              "entry_id": {
                "type": "string",
              },
              "offset": {
                "minimum": 0,
                "type": "integer",
              },
            },
            "type": "object",
          },
        },
      ],
    },
    {
      "on": [
        "session_before_compact",
        "[function]",
      ],
    },
    {
      "on": [
        "context",
        "[function]",
      ],
    },
    {
      "registerProvider": [
        "salaam-proof",
        {
          "api": "salaam-scripted",
          "apiKey": "local-fixture",
          "baseUrl": "http://unused.invalid",
          "models": [
            {
              "contextWindow": 32768,
              "cost": {
                "cacheRead": 0,
                "cacheWrite": 0,
                "input": 0,
                "output": 0,
              },
              "id": "scripted",
              "input": [
                "text",
              ],
              "maxTokens": 1024,
              "name": "Salaam offline proof provider",
              "reasoning": false,
            },
          ],
          "streamSimple": "[function]",
        },
      ],
    },
    {
      "on": [
        "session_start",
        "[function]",
      ],
    },
    {
      "on": [
        "session_shutdown",
        "[function]",
      ],
    },
  ],
  "prompt": "Base prompt.",
}
`;

