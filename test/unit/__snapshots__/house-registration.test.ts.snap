    {
      "on": [
        "context",
        "[function]",
      ],
    },
    {
      "registerProvider": [
        "salaam-proof",
        {
          "api": "salaam-scripted",
          "apiKey": "local-fixture",
          "baseUrl": "http://unused.invalid",
          "models": [
            {
              "contextWindow": 32768,
              "cost": {
                "cacheRead": 0,
                "cacheWrite": 0,
