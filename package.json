{
  "name": "@sjl/salaam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent Pi-backed agent session service",
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "salaam": "bin/salaam.mjs",
    "sal": "bin/salaam.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run test/unit",
    "test:proofs": "npm run build && vitest run test/proofs",
    "test:pi": "npm run build && vitest run test/pi",
    "verify:pi": "npm run build && node scripts/verify-pi.mjs",
    "verify:execution": "npm run build && node bin/salaam.mjs execution prove",
    "test:coding": "npm run build && node scripts/coding-acceptance.mjs",
    "demo:session": "npm run build && node scripts/demo.mjs",
    "demo:managed": "npm run build && node scripts/demo-managed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:children": "npm run build && node scripts/demo-children.mjs",
    "setup:cli": "npm run build && npm link --ignore-scripts --offline --no-audit --no-fund",
    "cli": "node bin/salaam.mjs",
    "demo:acceptance": "npm run build && node scripts/demo-acceptance.mjs",
    "test:acceptance": "npm run build && node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@xterm/headless": "5.5.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
