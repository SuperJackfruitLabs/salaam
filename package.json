{
  "name": "@superjackfruitlabs/salaam",
  "version": "0.0.6",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperJackfruitLabs/salaam.git"
  },
  "bugs": "https://github.com/SuperJackfruitLabs/salaam/issues",
  "homepage": "https://salaam.sh",
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "dist/src",
    "src",
    "pi-pin.json",
    "harness-runtime",
    "npm-shrinkwrap.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bundleDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "@modelcontextprotocol/sdk",
    "ajv",
    "ajv-formats",
    "typebox"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "A persistent Pi-backed agent session service",
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "salaam": "bin/salaam.mjs",
    "sal": "bin/salaam.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run test/unit",
    "test:proofs": "npm run build && vitest run test/proofs",
    "test:pi": "npm run build && vitest run test/pi",
    "verify:pi": "npm run build && node scripts/verify-pi.mjs",
    "verify:execution": "npm run build && node bin/salaam.mjs execution prove",
    "test:coding": "npm run build && node scripts/coding-acceptance.mjs",
    "demo:session": "npm run build && node scripts/demo.mjs",
    "demo:managed": "npm run build && node scripts/demo-managed.mjs",
    "docs:generate": "npm run build && node scripts/docs-generate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:children": "npm run build && node scripts/demo-children.mjs",
    "setup:cli": "npm run build && npm link --ignore-scripts --offline --no-audit --no-fund",
    "cli": "node bin/salaam.mjs",
    "demo:acceptance": "npm run build && node scripts/demo-acceptance.mjs",
    "test:acceptance": "npm run build && node scripts/acceptance.mjs",
    "test:tasks:real": "npm run build && vitest run --config vitest.real.config.ts",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "npm run build && node scripts/release-pack.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "sites:build": "npm --prefix landing run build && npm --prefix docs-site run build && node scripts/check-sites.mjs && node landing/scripts/check-frame.mjs",
    "sites:verify": "node scripts/verify-sites.mjs",
    "prepack": "node scripts/source-pack-guard.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@types/node": "26.6.5",
    "@xterm/headless": "5.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
