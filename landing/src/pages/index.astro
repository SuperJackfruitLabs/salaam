---
import { site, docs, repo, description } from '../../../site.config.mjs';
import '../styles/site.css';
// Latest published release. Update this one constant when a new release ships.
const release = '0.0.2';
const installer = new URL('/install.sh', site).href;
const install = `curl -fsSL ${installer} | sh -s -- --version ${release}`;
const steps = [
  {
    number: '01',
    title: 'Start the local service.',
    text: 'sal service start runs a service on your machine that owns your sessions. The default provider is offline, so your first session needs no API key and makes no paid requests.',
    link: '/quickstart/',
    label: 'Your first session',
  },
  {
    number: '02',
    title: 'Attach the terminal.',
    text: 'sal attach opens the terminal interface: a composer, reviewed changes, command logs, an operator inbox, and approvals on Ctrl O. Night and Paper themes.',
    link: '/tui/',
    label: 'Meet the terminal',
  },
  {
    number: '03',
    title: 'Detach and come back.',
    text: 'Close the terminal and the session keeps going. Reattach from another terminal, over SSH to a host you already have access to, or from an editor that speaks ACP (the Agent Client Protocol). Reconnecting replays what happened; it does not resend your instruction.',
    link: '/clients/',
    label: 'Ways to connect',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#151113" />
    <title>Salaam — agent coding sessions that outlast your terminal</title>
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Salaam — agent coding sessions that outlast your terminal" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}/social.svg`} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('salaam-theme');
        if (theme === 'paper' || theme === 'night') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="wrap">
      <header class="masthead">
        <a href="/" class="brand" aria-label="Salaam home">
          <img src="/mark.svg" width="34" height="34" alt="" />
          <span>
            salaam<span class="brand-dot">.</span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href={docs}>
            Docs <span aria-hidden="true">↗</span>
          </a>
          <a href={repo}>
            Source <span aria-hidden="true">↗</span>
          </a>
          <button
            id="theme"
            class="theme"
            aria-label="Switch Night and Paper theme"
            title="Switch theme"
          >
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="title">
          <div class="hero-inner">
          <div class="hero-copy">
            <h1 id="title">
              Agent coding sessions <em>that outlast your terminal.</em>
            </h1>
            <p class="hero-lede">
              Salaam is a persistent session service for terminal coding and unattended agent work,
              built on Pi. Each session, with its approvals and results, lives on your machine, so
              you can close the terminal and pick it up later.
            </p>
            <div class="hero-actions">
              <a class="button primary" href={`${docs}/quickstart/`}>Get started</a>
              <a class="button secondary" href={docs}>Docs</a>
            </div>
          </div>
          <div class="session-scene">
            <div
              class="terminal"
              role="img"
              aria-label="Illustrative Salaam session. A coding task has one verified step, one approval awaiting review, and a saved checkpoint. An SSH reconnection opens the same session."
            >
              <div class="terminal-top">
                <span class="terminal-brand">◒ &nbsp; salaam</span>
                <span class="terminal-meta">night · connected</span>
              </div>
              <div class="terminal-tabs">
                <span class="active">Conversation</span>
                <span>
                  Changes <b>2</b>
                </span>
                <span>Commands</span>
                <span>Context</span>
              </div>
              <div class="terminal-body">
                <div class="terminal-path">
                  ~/projects/a-little-better <span>main</span>
                </div>
                <p class="terminal-who">
                  YOU <span>09:41</span>
                </p>
                <p class="prompt">Fix the parser and prove the edge cases.</p>
                <p class="terminal-who accent">
                  SALAAM <span>09:42</span>
                </p>
                <p>
                  I’ve prepared the patch in the owned workspace.
                  <br />
                  The next operation is ready for your review.
                </p>
                <div class="task-line">
                  <span class="accent">✓</span>
                  <span>Inspect parser behavior</span>
                  <span class="pill">verified</span>
                </div>
                <div class="task-line">
                  <span class="amber">◇</span>
                  <span>Apply reviewed patch</span>
                  <span class="pill amber">approval</span>
                </div>
                <div class="task-line muted">
                  <span>○</span>
                  <span>Run acceptance checks</span>
                  <span>pending</span>
                </div>
                <div class="checkpoint">
                  <span class="accent">↳</span> checkpoint saved <span>·</span> waiting for you
                </div>
              </div>
              <div class="composer">
                <span class="accent">›</span>
                <span>Send an instruction…</span>
                <span class="key">↵</span>
              </div>
              <div class="terminal-foot">
                <span>Ctrl K actions &nbsp; Ctrl O approvals</span>
                <span class="accent">● session persisted</span>
              </div>
            </div>
            <p class="hero-caption">
              Example session, an illustrative mock-up · controls in the{' '}
              <a href={`${docs}/tui/`}>terminal guide</a>
            </p>
          </div>
          </div>
        </section>
        <section id="how" class="section journey" aria-labelledby="how-title">
          <div class="section-heading">
            <p class="eyebrow">HOW IT WORKS</p>
            <h2 id="how-title">
              One service.
              <br />
              <em>Any terminal.</em>
            </h2>
            <p>The terminal, SSH and your editor are clients. The service keeps the record.</p>
          </div>
          <div class="journey-list">
            {steps.map((item) => (
              <article>
                <span class="number">{item.number}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <a class="text-link" href={`${docs}${item.link}`}>
                    {item.label} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section class="section modes" aria-labelledby="use-title">
          <div class="mode-copy">
            <p class="eyebrow">WHAT IT'S LIKE TO USE</p>
            <h2 id="use-title">
              Say you ask it to
              <br />
              <em>fix a parser.</em>
            </h2>
            <p>
              With coding switched on, Salaam's Pi worker edits a copy of your project in a
              workspace the service owns, not your checkout. Before the patch is applied, the
              operation waits in your approval inbox, and your approval covers exactly the
              arguments and target you reviewed. If you made it a checked task, the model saying
              "done" is not enough: the checks have to pass first. You can detach at any point and
              reattach later to the same state.
            </p>
            <p>
              You can also hand a step to a specialist (an explorer, builder, reviewer or tester)
              whose draft stays private until you integrate it, or to a Claude, Codex or Gemini
              harness route. Today all three harness routes run on your host's Claude API key and
              Sonnet 4.6; Codex and Gemini are translated to that backend, not run against OpenAI
              or Google models. They need Docker and a prepared runtime bundle.
            </p>
            <p>
              Salaam can also ask another agent on the network for an opinion over A2A (the
              Agent2Agent protocol), including documented Hermes and OpenClaw routes. Those peers
              return analysis, never patches. For unattended work there are jobs and recurring
              schedules; each run gets a fresh workspace and explicit overlap rules. It is not an
              open-ended background cron.
            </p>
            <a class="text-link" href={`${docs}/coding/`}>
              Read about coding <span aria-hidden="true">↗</span>
            </a>
          </div>
          <figure class="real-tui">
            <img
              src="/tui-night.png"
              alt="Salaam Night terminal from an offline example session, showing a guarded diff and the workspace rail."
              loading="lazy"
              width="1536"
              height="960"
            />
            <figcaption>Offline example · a test session, not a real coding run</figcaption>
          </figure>
        </section>
        <section class="section start" aria-labelledby="start-title">
          <div>
            <p class="eyebrow">RUN IT YOURSELF</p>
            <h2 id="start-title">
              Install <em>v{release}.</em>
            </h2>
            <p>
              Needs Node 26.7.0 and npm 11.19.0, both exactly. macOS and Linux; Windows is
              untested. Coding commands need Docker. The installer checks the release's SHA-256
              before installing. Then start a service and your first session:
            </p>
            <div class="copy-command">
              <code>sal service start --state /tmp/salaam-try<br />sal session create --cwd "$PWD" --state /tmp/salaam-try<br />sal attach SESSION_ID --state /tmp/salaam-try</code>
            </div>
            <p>
              Replace SESSION_ID with the ID the second command prints. It runs on your own machine,
              under your own OS account.
            </p>
          </div>
          <div class="install-card">
            <p class="eyebrow">INSTALL v{release}</p>
            <div class="copy-command">
              <code id="install-command">{install}</code>
              <button id="copy" aria-label="Copy install command">
                Copy
              </button>
            </div>
            <p id="copy-status" aria-live="polite">
              <a href={installer}>Read the installer</a> or see the{' '}
              <a href={`${docs}/install/`}>installation guide</a>.
            </p>
          </div>
        </section>
        <aside class="limits">
          <span class="eyebrow">WHERE IT RUNS TODAY</span>
          <p>
            Salaam is early software. It is for one trusted OS account on one machine; there is no
            multi-tenant API. If the service or worker dies, work in flight is interrupted and you
            continue it explicitly; nothing is replayed for you. SSH needs a host you can already
            reach and Salaam installed there; it provisions no servers and copies no credentials.
            Saved provider keys are stored as permission-protected plaintext, and live provider
            requests, including Claude, may be billable. Harness routes all run on Claude and
            Sonnet 4.6. The approval-binding checks were verified in the project's own local run
            (2026-10-17, macOS arm64), not independently. Some features on main, such as running
            coding without Docker and MCP tool admission, are not in v{release}.
          </p>
          <a class="text-link" href={`${docs}/limitations/`}>
            Read the limitations <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </main>
      <footer>
        <a class="brand" href="/">
          <img src="/mark.svg" width="25" height="25" alt="" />
          <span>salaam.</span>
        </a>
        <nav aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={repo}>Source</a>
          <a href="https://superjackfruit.com">Super Jackfruit Labs ↗</a>
        </nav>
      </footer>
    </div>
    <script>
      const theme = document.querySelector<HTMLButtonElement>('#theme');
      theme?.addEventListener('click', () => {
        const current =
          document.documentElement.dataset.theme ??
          (matchMedia('(prefers-color-scheme: light)').matches ? 'paper' : 'night');
        const next = current === 'night' ? 'paper' : 'night';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('salaam-theme', next);
        } catch {}
      });
      document.querySelector('#copy')?.addEventListener('click', async () => {
        const status = document.querySelector('#copy-status');
        try {
          const command = document.querySelector('#install-command')?.textContent;
          if (!command) return;
          await navigator.clipboard.writeText(command);
          if (status) status.textContent = 'Copied. Paste into your terminal to install Salaam.';
        } catch {
          if (status) status.textContent = 'Select the command to copy it manually.';
        }
      });
    </script>
  </body>
</html>
